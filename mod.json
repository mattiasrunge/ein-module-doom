{
  "name": "doom",
  "version": "0.4.0",
  "description": "Doom, Heretic and Hexen in EiN: Crispy Doom built to WebAssembly, played on the Games page, alone or together",
  "license": "GPL-2.0-or-later",
  "coreApi": "^0.15.77",
  "dependencies": {
    "games": "^0.1.3-dev.8"
  },
  "exports": {
    "./api": "./lib/api.ts"
  },
  "imports": {
    "@doom/api": "./lib/api.ts",
    "@doom/server": "./lib/server.ts",
    "@doom/wads": "./lib/wads.ts"
  },
  "ui": {
