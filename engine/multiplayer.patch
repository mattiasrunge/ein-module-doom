+// [EiN] What a game EiN hosts starts the game with, as D_StartNetGame
+// has it before it sends it: the server's own settings take its place.
+
+void D_EIN_GameSettings(net_gamesettings_t *settings)
+{
+    int i;
+
+    settings->consoleplayer = 0;
+    settings->num_players = 1;
+    settings->player_classes[0] = player_class;
+    settings->new_sync = !M_ParmExists("-oldsync");
+
+    i = M_CheckParmWithArgs("-extratics", 1);
+    settings->extratics = i > 0 ? atoi(myargv[i+1]) : 1;
+    settings->ticdup = 1;
+}
+
+// [EiN] The server has sent the game's start: the tics it sends from
+// now on are the game's from `first` on, its first or this player's
+// join tic, as are those this player makes. Called as the start comes,
+// before any tic that came with it is taken.
+
+void D_EIN_BeginTics(int first)
+{
+    memset(ticdata, 0, sizeof(ticdata));
+    maketic = first;
+    recvtic = first;
+}
+
+// [EiN] The game the server started for this player begins, from its
+// first tic, as D_StartNetGame begins it once the server has sent it,
+// with `class` the player's class. A player who joins it while it is
+// played plays the tics before their join tic through first
+// (D_EIN_PlayTic).
+
+void D_EIN_StartNetGame(net_gamesettings_t *settings, int class)
+{
+    int i;
+
+    player_class = class;
+    localplayer = settings->consoleplayer;
+
+    for (i = 0; i < NET_MAXPLAYERS; ++i)
+    {
+        local_playeringame[i] = i < settings->num_players;
+    }
+
+    ticdup = settings->ticdup;
+    new_sync = settings->new_sync;
+    offsetms = 0;
+    skiptics = 0;
+    gametic = 0;
+    lasttime = GetAdjustedTime() / ticdup;
+}
+
+// [EiN] Run a tic played before this player joined, with every player's
+// ticcmd, whether they are in it and whether they join at it.
+
+void D_EIN_PlayTic(ticcmd_t *cmds, boolean *ingame, int *joined)
+{
+    memcpy(local_playeringame, ingame, sizeof(local_playeringame));
+    ein_joined = joined;
+    loop_interface->RunTic(cmds, ingame);
+    ein_joined = NULL;
+    ++gametic;
+}
+
+// [EiN] Every tic before the join tic has been played: the player's own
+// tics are made from now on, none for the time it took.
+
+void D_EIN_Play(void)
+{
+    lasttime = GetAdjustedTime() / ticdup;
+}
+
 void D_RegisterLoopCallbacks(loop_interface_t *i)
 {
     loop_interface = i;
