+// [EiN] Seat `client`, who connected while the game is played and is
+// ready: at a player's place nobody plays from, from a tic nobody has
+// been sent yet, after one the place's last player was not in, so every
+// game sees the place's player leave before the new one joins. They are
+// sent the game as it started, at their place and with the tic they
+// join at (NET_PACKET_TYPE_EIN_JOIN), and ask for the tics before it.
+
+static void NET_SV_EIN_Seat(net_client_t *client)
+{
+    net_gamesettings_t settings;
+    net_packet_t *packet;
+    unsigned int join_tic;
+    int place = -1;
+    int i;
+
+    for (i = 0; i < NET_SV_MaxPlayers() && i < NET_MAXPLAYERS; ++i)
+    {
+        if (sv_players[i] == NULL || !ClientConnected(sv_players[i]))
+        {
+            place = i;
+            break;
+        }
+    }
+
+    if (place < 0)
+    {
+        NET_SV_SendReject(client->addr, "Server is full!");
+        NET_SV_DisconnectClient(client);
+        return;
+    }
+
+    join_tic = recvwindow_start;
+
+    for (i = 0; i < MAXNETNODES; ++i)
+    {
+        if (ClientConnected(&clients[i]) && !clients[i].late
+         && clients[i].sendseq > join_tic)
+        {
+            join_tic = clients[i].sendseq;
+        }
+    }
+
+    for (i = BACKUPTICS - 1; i >= 0; --i)
+    {
+        if (recvwindow[i][place].active)
+        {
+            if (recvwindow_start + i + 2 > join_tic)
+            {
+                join_tic = recvwindow_start + i + 2;
+            }
+            break;
+        }
+    }
+
+    for (i = 0; i < BACKUPTICS; ++i)
+    {
+        memset(&recvwindow[i][place], 0, sizeof(recvwindow[i][place]));
+    }
+
+    sv_players[place] = client;
+    client->player_number = place;
+    client->late = false;
+    client->ready = true;
+    client->sendseq = join_tic;
+    client->acknowledged = join_tic;
+    client->last_gamedata_time = I_GetTimeMS();
+    sv_join_tic[place] = join_tic;
+    sv_joined_late[place] = true;
+    sv_join_class[place] = client->player_class + 1;
+
+    settings = sv_start_settings;
+    settings.consoleplayer = place;
+
+    packet = NET_Conn_NewReliable(&client->connection, NET_PACKET_TYPE_EIN_JOIN);
+    NET_WriteSettings(packet, &settings);
+    NET_WriteInt32(packet, join_tic);
+
+    NET_Log("server: %s joins as player %d at tic %d",
+            NET_AddrToString(client->addr), place, join_tic);
+    printf("%s joins as player %d at tic %d\n", client->name, place + 1,
+           join_tic);
+}
