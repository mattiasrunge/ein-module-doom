+// [EiN] Who plays, for EiN's list of the games hosted: each player's
+// name and address (a.b.c.d), as JSON, into `buffer`.
+
+void NET_SV_EIN_Status(char *buffer, size_t size)
+{
+    size_t used;
+    int i;
+    boolean first = true;
+
+    used = M_snprintf(buffer, size, "{\"map\":\"\",\"players\":[");
+
+    for (i = 0; i < MAXNETNODES && used < size; ++i)
+    {
+        net_client_t *client = &clients[i];
+        char name[2 * MAXPLAYERNAME];
+        unsigned int ip;
+        size_t n = 0;
+        const char *c;
+
+        if (!ClientConnected(client) || client->drone || client->name == NULL)
+        {
+            continue;
+        }
+
+        for (c = client->name; *c != '\0' && n < sizeof(name) - 2; ++c)
+        {
+            if (*c == '"' || *c == '\\')
+            {
+                name[n++] = '\\';
+            }
+            if ((unsigned char) *c >= ' ')
+            {
+                name[n++] = *c;
+            }
+        }
+        name[n] = '\0';
+
+        ip = NET_EIN_AddrIp(client->addr);
+        used += M_snprintf(buffer + used, size - used,
+                           "%s{\"name\":\"%s\",\"address\":\"%u.%u.%u.%u\"}",
+                           first ? "" : ",", name, (ip >> 24) & 0xff,
+                           (ip >> 16) & 0xff, (ip >> 8) & 0xff, ip & 0xff);
+        first = false;
+    }
+
+    if (used < size)
+    {
+        M_snprintf(buffer + used, size - used, "]}");
+    }
+}
+
+// [EiN] The player at the address `ip` has left: their link to the
+// game closed. They are dropped at once, rather than once they have
+// been silent long enough, so nobody waits for them.
+
+void NET_SV_EIN_Drop(unsigned int ip)
+{
+    int i;
+
+    for (i = 0; i < MAXNETNODES; ++i)
+    {
+        if (clients[i].active && NET_EIN_AddrIp(clients[i].addr) == ip)
+        {
+            clients[i].connection.state = NET_CONN_STATE_DISCONNECTED;
+            clients[i].connection.disconnect_reason = NET_DISCONNECT_REMOTE;
+        }
+    }
+}
