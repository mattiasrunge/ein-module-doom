+// [EiN] Connect to the server at `addr` without waiting for it: the
+// SYN is sent, again every second, by NET_CL_EIN_Connecting, which the
+// game calls each frame until it answers. Whatever the server sends
+// after its answer (a hosted game launches at once) is taken from then
+// on.
+
+boolean NET_CL_EIN_StartConnect(net_addr_t *addr, net_connect_data_t *data)
+{
+    server_addr = addr;
+    NET_ReferenceAddress(addr);
+    connect_data = *data;
+
+    memcpy(net_local_wad_sha1sum, data->wad_sha1sum, sizeof(sha1_digest_t));
+    memcpy(net_local_deh_sha1sum, data->deh_sha1sum, sizeof(sha1_digest_t));
+    net_local_is_freedoom = data->is_freedoom;
+
+    client_context = NET_NewContext();
+
+    if (!addr->module->InitClient())
+    {
+        SetRejectReason("Failed to initialize client module");
+        NET_ReleaseAddress(server_addr);
+        return false;
+    }
+
+    NET_AddModule(client_context, addr->module);
+
+    net_client_connected = true;
+    net_client_received_wait_data = false;
+    drone = data->drone;
+    client_state = CLIENT_STATE_WAITING_LAUNCH;
+
+    NET_Conn_InitClient(&client_connection, addr, NET_PROTOCOL_UNKNOWN);
+
+    connect_start_time = I_GetTimeMS();
+    connect_last_send_time = -1;
+    SetRejectReason("Unknown reason");
+
+    return true;
+}
+
+// [EiN] 1 once connected, 0 while connecting, -1 when the server refused
+// or did not answer within 5 seconds (net_client_reject_reason says).
+
+int NET_CL_EIN_Connecting(void)
+{
+    int nowtime = I_GetTimeMS();
+
+    if (client_connection.state == NET_CONN_STATE_CONNECTING)
+    {
+        if (nowtime - connect_last_send_time > 1000 || connect_last_send_time < 0)
+        {
+            NET_CL_SendSYN(&connect_data);
+            connect_last_send_time = nowtime;
+        }
+
+        NET_CL_Run();
+
+        if (client_connection.state == NET_CONN_STATE_CONNECTING
+         && nowtime - connect_start_time > 5000)
+        {
+            SetRejectReason("No response from server");
+            client_connection.state = NET_CONN_STATE_DISCONNECTED;
+        }
+    }
+
+    if (client_connection.state == NET_CONN_STATE_CONNECTED)
+    {
+        SetRejectReason(NULL);
+        return 1;
+    }
+
+    if (client_connection.state == NET_CONN_STATE_CONNECTING)
+    {
+        return 0;
+    }
+
+    NET_CL_Shutdown();
+    return -1;
+}
