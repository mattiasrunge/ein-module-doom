+// [EiN] Called when a player joins the game while it is played: they
+// are reborn at the start of the tic as a player who came back after
+// dying would be, with nothing of whoever played from their place
+// before, whose body stays where it fell.
+
+static void PlayerJoinGame(int player_num)
+{
+    static char joinmsg[80];
+    player_t *player = &players[player_num];
+
+    M_StringCopy(joinmsg, DEH_String("Player 1 joined the game"),
+                 sizeof(joinmsg));
+    joinmsg[7] += player_num;
+
+    if (player->mo != NULL)
+    {
+        player->mo->player = NULL;
+    }
+
+    memset(player, 0, sizeof(*player));
+    playeringame[player_num] = true;
+    player->playerstate = PST_REBORN;
+
+    if (player_num == consoleplayer)
+    {
+        displayplayer = consoleplayer;
+    }
+    else
+    {
+        players[consoleplayer].message = joinmsg;
+    }
+}
