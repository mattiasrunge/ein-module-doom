+// [EiN] Answer a request for the tics played from `start` on, as many
+// as there are, in a few replies; the tics of a reply are whole.
+
+static void NET_SV_EIN_ParseHistoryRequest(net_packet_t *packet,
+                                           net_client_t *client)
+{
+    unsigned int start;
+    int reply;
+
+    if (!NET_ReadInt32(packet, &start))
+    {
+        return;
+    }
+
+    for (reply = 0; reply < EIN_HISTORY_REPLIES && start < sv_history_tics;
+         ++reply)
+    {
+        net_packet_t *out;
+        unsigned int end = start + 1;
+        unsigned int from = sv_history_at[start];
+        unsigned int to;
+
+        // Where the tic `t` starts, or the history ends.
+#define EIN_TIC_AT(t) ((t) < sv_history_tics ? sv_history_at[t] : sv_history->len)
+
+        while (end < sv_history_tics && EIN_TIC_AT(end + 1) - from <= EIN_HISTORY_CHUNK)
+        {
+            ++end;
+        }
+
+        to = EIN_TIC_AT(end);
+#undef EIN_TIC_AT
+
+        out = NET_NewPacket(to - from + 16);
+        NET_WriteInt16(out, NET_PACKET_TYPE_EIN_HISTORY);
+        NET_WriteInt32(out, start);
+        NET_WriteInt32(out, end - start);
+        NET_WriteInt32(out, to - from);
+        memcpy(out->data + out->len, sv_history->data + from, to - from);
+        out->len += to - from;
+        NET_Conn_SendPacket(&client->connection, out);
+        NET_FreePacket(out);
+
+        start = end;
+    }
+}
