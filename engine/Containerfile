# Builds Crispy Doom's Doom, Heretic and Hexen to WebAssembly for the module's engine worker:
# assets/<game>.js and assets/<game>.wasm, single-threaded, with no SDL, no DOM and no main loop
# (build.sh, ein_main.c, ein_video.c). The sound effects are mixed in the engine (ein_sound.c) over
# Crispy's OPL music on the Nuked OPL3 emulator (opl_ein.c), rendered as the worker asks for it.
#
#   docker buildx build --file engine/Containerfile --output type=local,dest=assets engine
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory; scripts/build-engine.sh does exactly this.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64).
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# Crispy Doom, pinned at its release 7.2. GPL-2.0-or-later, like this module; opl3.c is
# LGPL-2.1-or-later.
ARG CRISPY_DOOM_COMMIT=fdeabe4c23a833534b70aa84a22f1685aae7125d
RUN git init -q /src/crispy \
  && git -C /src/crispy fetch -q --depth 1 https://github.com/fabiangreffrath/crispy-doom.git ${CRISPY_DOOM_COMMIT} \
  && git -C /src/crispy checkout -q FETCH_HEAD

# SDL 2's headers, pinned at its release 2.32.10: the sources include them, and the few SDL calls
# left outside video, sound and the joystick are this build's own (ein_sdl.c). No SDL is linked.
ARG SDL_COMMIT=5d249570393f7a37e037abf22cd6012a4cc56a71
RUN git init -q /src/SDL \
  && git -C /src/SDL fetch -q --depth 1 https://github.com/libsdl-org/SDL.git ${SDL_COMMIT} \
  && git -C /src/SDL checkout -q FETCH_HEAD

# Each game's loop hands its frame to the worker rather than running forever (loop.patch); Doom
# calls each state's action with as many arguments as it takes, which WebAssembly holds it to
# (actions.patch); and the games are played together on servers EiN hosts, joined from the page or
# the game's own menu, a game under way too, which its new player plays through to where the others
# are first (multiplayer.patch).
COPY loop.patch actions.patch multiplayer.patch /src/
RUN git -C /src/crispy apply /src/loop.patch /src/actions.patch /src/multiplayer.patch

WORKDIR /src
COPY config.h ein_main.c ein_net.c ein_server.c ein_video.c ein_sound.c ein_sdl.c ein_stubs.c net_ein.c opl_ein.c ein/
COPY build.sh ./

# Two compilers at a time keep the build's memory small beside a running EiN.
ENV EMCC_CORES=2
RUN sh build.sh /out \
  && echo "Crispy Doom 7.2 (${CRISPY_DOOM_COMMIT}) with loop.patch, actions.patch and multiplayer.patch, SDL ${SDL_COMMIT}'s headers, emsdk 6.0.13" > /out/doom-build.txt

FROM scratch
COPY --from=build /out/ /
